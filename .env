# --- Base de données PostgreSQL ---
DATABASE_URL="postgresql://arsn:arsn_password@localhost:5433/arsn_db"

# --- Authentification ---
JWT_SECRET="change-moi-avec-une-longue-chaine-aleatoire"
JWT_EXPIRES_IN="8h"

# --- Serveur ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:8081"

# --- Notifications (à brancher plus tard) ---
EMAIL_API_KEY=""
EMAIL_FROM="no-reply@arsn.sn"

# SMS (ex: Twilio, ou opérateur local Orange/Free)
SMS_API_KEY=""
SMS_SENDER="ARSN"

# --- Stockage des fichiers ---
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./uploads"
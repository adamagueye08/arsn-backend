# Copie ce fichier en ".env" et remplis les valeurs réelles.
# Ne jamais committer le fichier ".env" dans Git (voir .gitignore).

# --- Base de données PostgreSQL ---
# Format : postgresql://UTILISATEUR:MOTDEPASSE@HOTE:PORT/NOM_BASE
DATABASE_URL="postgresql://arsn:arsn_password@localhost:5432/arsn_db"

# --- Authentification ---
JWT_SECRET="change-moi-avec-une-longue-chaine-aleatoire"
JWT_EXPIRES_IN="8h"

# --- Serveur ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"

# --- Notifications (à brancher plus tard) ---
# Email (ex: Resend, SendGrid, ou SMTP institutionnel)
EMAIL_API_KEY=""
EMAIL_FROM="no-reply@arsn.sn"

# SMS (ex: Twilio, ou opérateur local Orange/Free)
SMS_API_KEY=""
SMS_SENDER="ARSN"

# --- Stockage des fichiers ---
# "local" pour stocker sur disque (dossier /uploads), ou "s3" pour un stockage objet
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./uploads"

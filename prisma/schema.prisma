// ============================================================
// ARSN - Modèle de données
// Plateforme de gestion des demandes d'autorisation
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// Rôles applicatifs (cf. structure des rôles recommandée)
// ------------------------------------------------------------
enum Role {
  DEMANDEUR       // client externe (particulier, entreprise, hôpital, etc.)
  SUPER_ADMIN     // contrôle total de la plateforme (paramétrage + traitement + signature)
  INSTRUCTEUR     // analyse technique et validation intermédiaire des demandes
  SIGNATAIRE      // validation finale, signature et délivrance des autorisations
}

enum TypeProfil {
  PARTICULIER
  ENTREPRISE
  HOPITAL
  LABORATOIRE
  INDUSTRIE
  AUTRE
}

enum StatutDemande {
  BROUILLON
  SOUMISE
  EN_COURS
  COMPLEMENT_REQUIS
  APPROUVEE
  REJETEE
  EXPIREE
}

enum CanalNotification {
  EMAIL
  SMS
}

enum StatutNotification {
  EN_ATTENTE
  ENVOYEE
  ECHEC
}

// ------------------------------------------------------------
// Utilisateurs (demandeurs ET agents internes, un seul modèle,
// distingué par le champ "role")
// ------------------------------------------------------------
model User {
  id             String       @id @default(uuid())
  email          String       @unique
  motDePasseHash String
  nom            String
  prenom         String
  telephone      String?
  role           Role         @default(DEMANDEUR)
  typeProfil     TypeProfil?  // pertinent surtout pour les DEMANDEUR
  organisation   String?
  actif          Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  demandes            Demande[]            @relation("DemandeurDemandes")
  demandesInstruites  Demande[]            @relation("InstructeurDemandes")
  actionsHistorique   HistoriqueDemande[]
  notifications       Notification[]
  autorisationsSignees AutorisationDelivree[]
  auditLogs           AuditLog[]

  @@map("users")
}

// ------------------------------------------------------------
// Types d'autorisation (paramétrable par l'Admin fonctionnel)
// importation / exportation / détention / transport / etc.
// ------------------------------------------------------------
model TypeAutorisation {
  id                String   @id @default(uuid())
  nom               String   @unique
  description       String?
  formulaireSchema  Json     // définition dynamique du formulaire (champs, types, validations)
  piecesRequises    Json     // liste des pièces justificatives obligatoires
  dureeValiditeMois Int      @default(12)
  frais             Decimal? @db.Decimal(12, 2)
  actif             Boolean  @default(true)
  createdAt         DateTime @default(now())

  demandes        Demande[]
  etapesWorkflow  WorkflowEtape[]
  modelesDocument ModeleDocument[]

  @@map("types_autorisation")
}

// ------------------------------------------------------------
// Étapes de workflow, définies par type d'autorisation
// ------------------------------------------------------------
model WorkflowEtape {
  id                 String            @id @default(uuid())
  typeAutorisationId String
  typeAutorisation   TypeAutorisation  @relation(fields: [typeAutorisationId], references: [id], onDelete: Cascade)
  ordre              Int
  nom                String
  roleResponsable    Role
  delaiJours         Int               @default(5)

  @@unique([typeAutorisationId, ordre])
  @@map("workflow_etapes")
}

// ------------------------------------------------------------
// Demande d'autorisation
// ------------------------------------------------------------
model Demande {
  id                 String            @id @default(uuid())
  numero             String            @unique // ex: DEM-2026-000123
  demandeurId        String
  demandeur          User              @relation("DemandeurDemandes", fields: [demandeurId], references: [id])
  typeAutorisationId String
  typeAutorisation   TypeAutorisation  @relation(fields: [typeAutorisationId], references: [id])
  statut             StatutDemande     @default(BROUILLON)
  donnees            Json              // réponses du formulaire dynamique
  instructeurId      String?
  instructeur        User?             @relation("InstructeurDemandes", fields: [instructeurId], references: [id])
  etapeActuelle      String?           // nom de l'étape en cours

  dateDepot          DateTime?
  dateDecision        DateTime?
  dateExpiration      DateTime?

  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  pieces          PieceJustificative[]
  historique      HistoriqueDemande[]
  autorisation    AutorisationDelivree?

  @@index([statut])
  @@index([demandeurId])
  @@map("demandes")
}

// ------------------------------------------------------------
// Pièces justificatives jointes à une demande
// ------------------------------------------------------------
model PieceJustificative {
  id          String   @id @default(uuid())
  demandeId   String
  demande     Demande  @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  nomFichier  String
  cheminStockage String // chemin ou URL du fichier stocké
  typeMime    String
  tailleOctets Int
  uploadedAt  DateTime @default(now())

  @@map("pieces_justificatives")
}

// ------------------------------------------------------------
// Historique / fil d'échanges d'une demande (traçabilité complète)
// ------------------------------------------------------------
model HistoriqueDemande {
  id          String   @id @default(uuid())
  demandeId   String
  demande     Demande  @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  parUserId   String
  parUser     User     @relation(fields: [parUserId], references: [id])
  action      String   // ex: "SOUMISSION", "COMPLEMENT_DEMANDE", "VALIDATION", "MESSAGE"
  commentaire String?
  createdAt   DateTime @default(now())

  @@map("historique_demandes")
}

// ------------------------------------------------------------
// Notifications (email / SMS)
// ------------------------------------------------------------
model Notification {
  id        String              @id @default(uuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id])
  canal     CanalNotification
  sujet     String
  contenu   String
  statut    StatutNotification  @default(EN_ATTENTE)
  envoyeeAt DateTime?
  createdAt DateTime            @default(now())

  @@map("notifications")
}

// ------------------------------------------------------------
// Modèles de documents (courriers, autorisations types)
// ------------------------------------------------------------
model ModeleDocument {
  id                 String            @id @default(uuid())
  nom                String
  typeAutorisationId String?
  typeAutorisation   TypeAutorisation? @relation(fields: [typeAutorisationId], references: [id])
  contenuTemplate    String            // template HTML/texte avec variables {{...}}
  createdAt          DateTime          @default(now())

  @@map("modeles_documents")
}

// ------------------------------------------------------------
// Autorisation délivrée (PDF signé + QR code de vérification)
// ------------------------------------------------------------
model AutorisationDelivree {
  id             String    @id @default(uuid())
  demandeId      String    @unique
  demande        Demande   @relation(fields: [demandeId], references: [id])
  pdfCheminStockage String
  pdfNomFichier  String?
  qrCodeValeur   String?   // valeur encodée / URL de vérification publique — génération auto prévue en Phase 8
  signeParId     String
  signePar       User      @relation(fields: [signeParId], references: [id])
  dateSignature  DateTime  @default(now())

  @@map("autorisations_delivrees")
}

// ------------------------------------------------------------
// Journal d'audit (sécurité, conformité)
// ------------------------------------------------------------
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entite    String
  entiteId  String?
  detail    Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entite, entiteId])
  @@map("audit_logs")
}
